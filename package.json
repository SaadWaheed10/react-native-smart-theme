{
  "name": "react-native-smart-theme",
  "version": "0.1.0",
  "description": "Dark/light mode theme engine for React Native & Expo — mode switcher (light/dark/system), one-seed palettes, themed styles/components, image→theme, Material You, optional smart contrast",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "typescript": "tsc --noEmit",
    "prepare": "bob build",
    "build": "bob build",
    "test": "jest",
    "test:watch": "jest --watch",
    "example": "yarn --cwd example start",
    "example:ios": "yarn --cwd example ios",
    "example:android": "yarn --cwd example android",
    "prepublishOnly": "bob build && npm test"
  },
  "keywords": [
    "react-native",
    "expo",
    "theme",
    "dark-mode",
    "light-mode",
    "accessibility",
    "wcag",
    "apca",
    "adaptive",
    "palette",
    "material-you",
    "image-theme",
    "stylesheet",
    "themed-styles"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaadWaheed10/react-native-smart-theme.git"
  },
  "bugs": {
    "url": "https://github.com/SaadWaheed10/react-native-smart-theme/issues"
  },
  "homepage": "https://github.com/SaadWaheed10/react-native-smart-theme#readme",
  "author": {
    "name": "Saad Waheed",
    "url": "https://github.com/SaadWaheed10"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": ">=3.0.0",
    "react-native-mmkv": ">=2.0.0",
    "@react-native-async-storage/async-storage": ">=1.0.0",
    "react-native-image-colors": ">=2.0.0",
    "react-native-material-you-colors": "*"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-mmkv": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "react-native-image-colors": {
      "optional": true
    },
    "react-native-material-you-colors": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.0",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "react-native": "^0.74.0",
    "react-native-builder-bob": "^0.23.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
